# Explicit ACME issuer: IP addresses otherwise use Caddy's private local CA.
# Let's Encrypt shortlived supports IP subjects; Caddy renews automatically.
{
    default_sni {$APP_DOMAIN}
    https_port {$APP_HTTPS_PORT:443}
}

https://{$APP_DOMAIN}:{$APP_HTTPS_PORT:443} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    encode gzip
    request_body {
        max_size 13MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        Referrer-Policy "same-origin"
        X-Frame-Options "DENY"
    }
    reverse_proxy 127.0.0.1:8767
}
