# 服务端配置，复制到 .env 并填写后重启
MODEL_API_KEY=
MODEL_BASE_URL=http://127.0.0.1:3000/v1
MODEL_NAME=gemini-3.8-flash-low
# 可选：分别选择读图和整理模型；留空时使用上面的 MODEL_NAME
VISION_MODEL_NAME=
RECIPE_MODEL_NAME=
PORT=8767
# 电脑本机默认127.0.0.1；家庭局域网手机访问时设为0.0.0.0
HOST=127.0.0.1
# 可选：默认数据库为项目内.data/accounts.sqlite3
# ACCOUNT_DB=
# PostgreSQL configured on the server; leave empty for SQLite development.
DATABASE_URL=
BLOB_ROOT=.data/files
DB_POOL_SIZE=8
APP_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
AI_MAX_PENDING=3
AI_DAILY_TASKS=30
AI_MAX_ATTEMPTS=3
HOUSEHOLD_IMAGE_BYTES=250000000
# Only trust the reverse proxy you actually deploy.
TRUSTED_PROXY_IPS=127.0.0.1
# 公网HTTPS部署时设为1；本机HTTP保留0
ACCOUNT_SECURE_COOKIE=0
# 抖音公开分享页需要渲染时，默认启动独立的无头Chrome
DOUYIN_BROWSER_CHANNEL=chrome

# 四张原图拼成一张；每次最多4张拼图，最多3个并发请求
VISION_BATCH_SIZE=4
VISION_WORKERS=3
VISION_VIDEO_TILE_EDGE=480
VISION_PHOTO_TILE_EDGE=960
# 每个整理请求最多3道菜，最多4个请求并发；视频单菜跨帧保持完整
RECIPE_BATCH_SIZE=3
RECIPE_WORKERS=4
# 仅在平台提供相应画质时减少下载量；无低清流则保留可用视频
MEDIA_VIDEO_HEIGHT=480
# 保留3秒采样，4秒在测试中漏掉了短暂出现的用量
VIDEO_FRAME_INTERVAL=3
